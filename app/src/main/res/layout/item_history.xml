<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <ImageView
        android:id="@+id/imageViewHistoryFile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="File"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewHistoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewHistoryFile"
        app:layout_constraintTop_toTopOf="@id/imageViewHistoryFile" />

    <TextView
        android:id="@+id/textViewHistorySize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#757575"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/textViewHistoryName"
        app:layout_constraintStart_toStartOf="@id/textViewHistoryName"
        app:layout_constraintTop_toBottomOf="@id/textViewHistoryName" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierHistoryHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="imageViewHistoryFile,textViewHistorySize" />

    <TextView
        android:id="@+id/textViewHistoryUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#1565C0"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/buttonHistoryCopy"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierHistoryHeader" />

    <Button
        android:id="@+id/buttonHistoryCopy"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="Copy"
        android:textAllCaps="false"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@id/textViewHistoryUrl"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/viewHistoryDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewHistoryUrl" />

</androidx.constraintlayout.widget.ConstraintLayout>